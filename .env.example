# Скопируйте этот файл в .env и заполните значения.
# Файл .env не попадает в Git и в образ Docker (SPEC-023).

# Токен бота от @BotFather. Обязательная переменная.
BOT_TOKEN=

# Необязательный HTTP или SOCKS5 proxy для Telegram Bot API.
BOT_PROXY_URL=

# Строка подключения SQLAlchemy (SPEC-027). MVP использует SQLite.
# Относительный путь считается от рабочей директории; в Docker это /app.
DATABASE_URL=sqlite+aiosqlite:///data/postmaster.db

# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Часовой пояс по умолчанию в формате IANA (SPEC-002). Действует, пока пользователь не задал свой.
DEFAULT_TIMEZONE=Europe/Moscow

# Резервный режим для совместимости (старый POST_MODE также поддерживается).
# Пользователь всегда выбирает режим для каждого нового поста.
DEFAULT_POST_MODE=REMINDER
# Необязательный CSV разрешённых каналов; пустое значение не ограничивает выбор.
# TELEGRAM_TARGET_ALLOWLIST=@channel_one,-1001234567890
